<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="app_config.xml" />
        <exclude
            domain="file"
            path="last_task_log.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="app_config.xml" />
        <exclude
            domain="file"
            path="last_task_log.txt" />
    </device-transfer>
</data-extraction-rules>
